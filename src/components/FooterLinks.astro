---
import { getFooterLinks } from '../site.config';

const links = getFooterLinks();

const icons: Record<string, string> = {
  email: '<path d="M2 4.5A2.5 2.5 0 0 1 4.5 2h11A2.5 2.5 0 0 1 18 4.5v7A2.5 2.5 0 0 1 15.5 14h-11A2.5 2.5 0 0 1 2 11.5v-7Zm2.2-.5 5.3 4.2 5.3-4.2H4.2Z"/>',
  github: '<path d="M10 1.8a8.2 8.2 0 0 0-2.6 16c.4.1.6-.2.6-.4v-1.4c-2.4.5-2.9-1-2.9-1-.4-1-1-1.3-1-1.3-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.1 1 2.6.8.1-.6.3-1 .5-1.2-1.9-.2-3.9-1-3.9-4.3 0-1 .3-1.7.9-2.3-.1-.2-.4-1 .1-2.1 0 0 .8-.2 2.5.9a8.4 8.4 0 0 1 4.4 0c1.7-1.1 2.5-.9 2.5-.9.5 1.1.2 1.9.1 2.1.6.6.9 1.3.9 2.3 0 3.3-2 4.1-3.9 4.3.3.3.6.8.6 1.7v2.5c0 .2.2.5.6.4A8.2 8.2 0 0 0 10 1.8Z"/>',
  scholar: '<path d="M4 3.5h8.5l3.5 2v9H4v-11Zm2 2v1.5h6.5V5.5H6Zm0 3v1.5h6.5V8.5H6Zm0 3v1.5H11V11.5H6Z"/><path d="M3 15.5h11.5l-1.8 1.5H3v-1.5Z"/>',
  linkedin: '<path d="M4.5 4.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM3.5 8h2v7.5h-2V8Zm4 0h1.9v1c.4-.8 1.5-1.2 2.5-1.2 2.7 0 3.2 1.8 3.2 4.1V15.5H13V12.8c0-.8 0-1.8-1.1-1.8-1.1 0-1.3.9-1.3 1.7v2.8H8.5V8Z"/>',
  orcid: '<path d="M10 1.8a8.2 8.2 0 0 1 8.2 8.2 8.2 8.2 0 1 1-8.2-8.2Zm-2.1 3.4c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9Zm-1.1 2h2.2v6.4H6.8V7.2Zm3.3 0h2.1c2.2 0 3.5 1.2 3.5 3.2 0 2-1.3 3.2-3.5 3.2h-2.1V7.2Zm2.1 5.1c1 0 1.6-.6 1.6-1.9 0-1.2-.6-1.9-1.6-1.9h-.8v3.8h.8Z"/>',
};
---

<ul class="footer-links">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          <svg
            class="footer-icon"
            viewBox="0 0 20 20"
            width="14"
            height="14"
            aria-hidden="true"
            fill="currentColor"
            set:html={icons[link.icon]}
          />
          <span>{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>
