---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<article class="about-pillar">
  <span class="about-pillar__icon" aria-hidden="true">{icon}</span>
  <h3 class="about-pillar__title">{title}</h3>
  <p class="about-pillar__desc">{description}</p>
</article>
