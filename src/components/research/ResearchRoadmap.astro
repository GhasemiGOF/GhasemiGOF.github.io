---
const steps = [
  {
    label: 'Part 1 — the label',
    detail: 'Clicks, GFP, SAM: privileged, then gone',
    color: '#8b9cb5',
  },
  {
    label: 'Morphology',
    detail: 'Shape the model is allowed to keep',
    color: '#6b8f9e',
  },
  {
    label: 'The matching metric',
    detail: 'Clicks, not machine-mask Dice',
    color: '#5b7c99',
  },
  {
    label: 'Tissue structure',
    detail: 'Neighbors, at a cost in type',
    color: '#4a6d8a',
  },
  {
    label: 'What transfers',
    detail: 'Foundation models, if the claim survives',
    color: '#3d5a80',
  },
];
---

<figure class="research-roadmap" aria-label="Research roadmap from weak supervision to foundation models">
  <div class="research-roadmap__track">
    {steps.map((step, index) => (
      <>
        <div class="research-roadmap__step" style={`--step-color: ${step.color}`}>
          <div class="research-roadmap__node">
            <span class="research-roadmap__index">{index + 1}</span>
          </div>
          <div class="research-roadmap__content">
            <strong>{step.label}</strong>
            <span>{step.detail}</span>
          </div>
        </div>
        {index < steps.length - 1 && (
          <div class="research-roadmap__connector" aria-hidden="true">
            <svg viewBox="0 0 24 48" xmlns="http://www.w3.org/2000/svg">
              <line x1="12" y1="0" x2="12" y2="36" stroke="currentColor" stroke-width="1.5" />
              <path d="M6 32l6 8 6-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        )}
      </>
    ))}
  </div>

  <svg class="research-roadmap__diagram" viewBox="0 0 520 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="roadmap-diagram-title">
    <title id="roadmap-diagram-title">Research progression from supervision to foundation models</title>
    <defs>
      <linearGradient id="roadmap-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#eef3f7" />
        <stop offset="50%" stop-color="#dce8f0" />
        <stop offset="100%" stop-color="#c5d6e4" />
      </linearGradient>
    </defs>
    <rect x="10" y="30" width="500" height="60" rx="30" fill="url(#roadmap-gradient)" stroke="#e8e6e3" stroke-width="1" />
    {steps.map((step, index) => {
      const x = 52 + index * 104;
      return (
        <>
          <circle cx={x} cy="60" r="18" fill="#fcfcfb" stroke={step.color} stroke-width="2" />
          <text x={x} y="64" text-anchor="middle" font-family="IBM Plex Sans, system-ui, sans-serif" font-size="11" fill={step.color} font-weight="500">
            {index + 1}
          </text>
          {index < steps.length - 1 && (
            <line x1={x + 22} y1="60" x2={x + 82} y2="60" stroke={step.color} stroke-width="1.5" stroke-dasharray="4 3" opacity="0.6" />
          )}
        </>
      );
    })}
    <text x="52" y="108" font-family="IBM Plex Sans, system-ui, sans-serif" font-size="9" fill="#6b6b6b" text-anchor="middle">The label</text>
    <text x="260" y="108" font-family="IBM Plex Sans, system-ui, sans-serif" font-size="9" fill="#6b6b6b" text-anchor="middle">Shape, then the metric</text>
    <text x="468" y="108" font-family="IBM Plex Sans, system-ui, sans-serif" font-size="9" fill="#6b6b6b" text-anchor="middle">What transfers</text>
  </svg>
</figure>
